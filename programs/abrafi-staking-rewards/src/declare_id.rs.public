// Program IDs for each token deployment.
// Replace each compile_error! with the real declare_id! once the program ID is known.

#[cfg(feature = "usdaf")]
compile_error!("abrafi-staking-rewards USDAF program ID not set — replace this line with: declare_id!(\"PROGRAM_ID\");");

#[cfg(feature = "solaf")]
compile_error!("abrafi-staking-rewards SOLAF program ID not set — replace this line with: declare_id!(\"PROGRAM_ID\");");

#[cfg(not(any(feature = "usdaf", feature = "solaf")))]
compile_error!("Specify a token feature: --features usdaf  or  --features solaf");
